{
  "name": "boing",
  "version": "1.0.0",
  "description": "Boing Finance: cross-chain DeFi interface (EVM, Solana, Boing Network L1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boing-Network/boing.finance.git"
  },
  "homepage": "https://boing.finance",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm install && npm run dev",
    "dev:frontend": "cd frontend && npm install && npm start",
    "setup": "npm run setup:backend && npm run setup:frontend",
    "setup:backend": "cd backend && npm install",
    "setup:frontend": "cd frontend && npm install",
    "deploy:staging": "./deploy-backend.sh staging && ./deploy-frontend.sh staging",
    "deploy:prod": "./deploy-backend.sh production && ./deploy-frontend.sh production"
  },
  "keywords": [
    "defi",
    "dex",
    "ethereum",
    "polygon",
    "bsc",
    "arbitrum",
    "optimism",
    "avalanche",
    "fantom",
    "cross-chain",
    "swap",
    "liquidity",
    "yield",
    "farming",
    "staking",
    "governance",
    "dao",
    "nft",
    "metaverse",
    "web3",
    "blockchain",
    "cryptocurrency",
    "trading",
    "finance",
    "investment",
    "portfolio",
    "analytics",
    "bridge",
    "boing"
  ],
  "author": "Boing Network",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
