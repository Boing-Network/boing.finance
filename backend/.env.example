# Local Worker secrets — copy to backend/.env and never commit.
# Production/staging secrets belong in `wrangler secret`.

NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Optional webhook signing (required in production)
# ALCHEMY_WEBHOOK_SIGNING_KEY=
# HELIUS_WEBHOOK_SECRET=
# FARCASTER_WEBHOOK_SECRET=

# Solana JSON-RPC proxy (/api/solana/rpc)
# HELIUS_API_KEY=
# SOLANA_MAINNET_RPC=
# SOLANA_DEVNET_RPC=

# Optional admin gate for GET /api/r2/files
# ADMIN_API_KEY=
# R2_LIST_SECRET=

# Large-set NFT media collection budget (GiB) advertised by GET /api/r2/upload-limits.
# Default 10; set 50 when ready. Must match frontend REACT_APP_NFT_MEDIA_BUDGET_GB for UX.
# Also set in wrangler.toml [vars] / env.*.vars for deployed Workers.
# NFT_MEDIA_BUDGET_GB=10

# COINGECKO_API_KEY=
# OPENAI_API_KEY=
