# Used by most Hardhat networks (hex private key, no 0x prefix is ok if your tooling accepts it)
DEPLOYER_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Infura project id used by contracts/config/networks.js RPC URLs
INFURA_API_KEY=

# Receives TokenFactory service fees (defaults to deployer if unset)
# PLATFORM_WALLET=0x...

# Optional: override wrapped native for scripts/deploy-dex.js
# DEX_WETH=0x...
